BT /F1 10.5 Tf 46.00 574.00 Td (client for their platform.) Tj ET
BT /F3 8.5 Tf 46.00 541.00 Td (import { Client } from "@stomp/stompjs";) Tj ET
BT /F3 8.5 Tf 46.00 529.00 Td () Tj ET
BT /F3 8.5 Tf 46.00 517.00 Td (const accessToken = "user-access-token";) Tj ET
BT /F3 8.5 Tf 46.00 505.00 Td (// Use the same value as CHAT_WS_URL for your environment.) Tj ET
BT /F3 8.5 Tf 46.00 493.00 Td (const chatWsUrl = "ws://dev0:30083/ws/chat";) Tj ET
BT /F3 8.5 Tf 46.00 481.00 Td () Tj ET
BT /F3 8.5 Tf 46.00 469.00 Td (const client = new Client\({) Tj ET
BT /F3 8.5 Tf 46.00 457.00 Td (  brokerURL: chatWsUrl,) Tj ET
BT /F3 8.5 Tf 46.00 445.00 Td (  connectHeaders: {) Tj ET
BT /F3 8.5 Tf 46.00 433.00 Td (    Authorization: `Bearer ${accessToken}`,) Tj ET
BT /F3 8.5 Tf 46.00 421.00 Td (  },) Tj ET
BT /F3 8.5 Tf 46.00 409.00 Td (  onConnect: \(\) => {) Tj ET
BT /F3 8.5 Tf 46.00 397.00 Td (    client.subscribe\("/user/queue/private-messages", \(frame\) => {) Tj ET
BT /F3 8.5 Tf 46.00 385.00 Td (      const message = JSON.parse\(frame.body\);) Tj ET
BT /F3 8.5 Tf 46.00 373.00 Td (      console.log\("message", message\);) Tj ET
BT /F3 8.5 Tf 46.00 361.00 Td () Tj ET
BT /F3 8.5 Tf 46.00 349.00 Td (      client.publish\({) Tj ET
BT /F3 8.5 Tf 46.00 337.00 Td (        destination: "/app/chat.private.delivered",) Tj ET
BT /F3 8.5 Tf 46.00 325.00 Td (        body: JSON.stringify\({ messageId: message.messageId }\),) Tj ET
BT /F3 8.5 Tf 46.00 313.00 Td (        headers: { "content-type": "application/json" },) Tj ET
